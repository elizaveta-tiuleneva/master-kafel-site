# Скопируйте этот файл в .env.local и заполните значения.
# .env.local не попадает в git (см. .gitignore).
#
# В браузерный код попадают ТОЛЬКО переменные с префиксом VITE_.
# Секретные ключи (secret / service_role, DeepL, Telegram) сюда НЕ записываются —
# они хранятся в Supabase: Edge Functions → Secrets.

# Supabase: Project Settings → API Keys / Data API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) или устаревший anon key — оба публичные,
# доступ ограничивают правила RLS в базе.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Показывать демонстрационные проекты в рабочей сборке. Только для теста;
# в рабочем проекте оставьте пустым.
VITE_SHOW_DEMO_PROJECTS=
